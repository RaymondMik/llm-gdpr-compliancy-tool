# LLM backend: "ollama" (local, default) or "openai"
GDPR_CHECKER_PROVIDER=ollama

# Optional: model override (defaults: llama3.2 for ollama, gpt-4.1-mini for openai)
# GDPR_CHECKER_MODEL=llama3.2

# Ollama base URL (only needed if not running on the default port)
# OLLAMA_HOST=http://localhost:11434

# Only required when GDPR_CHECKER_PROVIDER=openai
# OPENAI_API_KEY=sk-...
